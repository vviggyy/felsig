# From @BotFather: /mybots -> your bot -> API Token
TELEGRAM_TOKEN=
# Your numeric Telegram user ID. Leave blank, message the bot, and it will tell you.
ALLOWED_USER_ID=
# Optional: healthchecks.io ping URL. The bot checks in every 10 min; healthchecks
# alerts you if it goes quiet (Mac asleep/off) for longer than you configure there.
HEARTBEAT_URL=
